# ============================================================
# AlgoLens Backend Environment Configuration
# ============================================================

# Server Port (Render automatically sets PORT in production)
PORT=5000

# Node Environment ('development' or 'production')
NODE_ENV=development

# Allowed Frontend Origins (Comma separated if multiple)
FRONTEND_URL=http://localhost:3000,https://algolens.vercel.app

# Supabase Credentials (Service Role Key stays strictly on backend)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Groq API Key & Model for Contextual AI Tutor
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Redis / Upstash Redis Configuration
# Option A: Upstash Serverless REST (Recommended for Render/Vercel to avoid connection pool exhaustion)
UPSTASH_REDIS_REST_URL=https://your-upstash-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token-here

# Option B: Standard Redis URI (e.g. rediss://default:...@your-upstash.upstash.io:6379 or local redis)
REDIS_URL=

# Upstash IOPS & Quota Management Flags
# Enable L1 In-Memory Buffer to save up to 90% of daily Upstash commands (default: true)
ENABLE_L1_CACHE=true
L1_CACHE_TTL_SECONDS=120
MAX_L1_CACHE_SIZE=1000

# Neo4j Graph DB (Aura Cloud recommended — fallback to static graph if omitted)
# For Neo4j AuraDB: use neo4j+s:// protocol
# For local Bolt:   use bolt://localhost:7687 (triggers static fallback)
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_aura_password
